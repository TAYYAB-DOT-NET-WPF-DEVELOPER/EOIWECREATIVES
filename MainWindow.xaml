<Window x:Class="WeCreatives_EOI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WeCreatives_EOI"
        mc:Ignorable="d"
        Title="WeCreatives  EOI"
        WindowStartupLocation="CenterScreen" 
        WindowState="Normal" 
        Icon="/Assets/Logo.png"
        Height="500" 
        Width="950">
    <Border  CornerRadius="5" Background="{DynamicResource Color1}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="Transparent">
                <ListView Grid.Row="1"
                                BorderBrush="{DynamicResource Color3}"
                                BorderThickness="2"
                                ItemsSource="{Binding AllOrders}" 
                                MaxHeight="{Binding ActualHeight, ElementName=listview}"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                ScrollViewer.CanContentScroll="True"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled" >
                    <ListView.View>
                        <GridView >
                            <GridView.Columns>
                                <GridViewColumn Header="Description" Width="420">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Descript}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Transact" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Transact}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Status" Width="80">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Status}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Time" Width="130">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Time}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Customer" Width="130">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding NAME}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView.Columns>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style TargetType="GridViewColumnHeader">
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Setter Property="Background" Value="{DynamicResource Color3}"/>
                                    <Setter Property="FontSize" Value="18"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource Color0}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                        </GridView>
                    </ListView.View>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Border>
            <!--Buttons-->
            <Border Margin="0,0,0,5" CornerRadius="5" Grid.Row="2" Grid.ColumnSpan="4" BorderBrush="{DynamicResource Color3}" BorderThickness="1">
            </Border>
            <Grid Grid.Row="1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button 
                        Width="140"
                        Margin="5,0,0,5"
                        Command="{Binding RunCodeCommand}"
                        Style="{DynamicResource MainButton}"
                        Content="Start"/>
                    <Button 
                        Width="140"
                        Margin="5,0,0,5"
                        Command="{Binding StopCodeCommand}"
                        Style="{DynamicResource MainButton}"
                        Content="Stop"/>
                    <Button 
                        Width="140"
                        Margin="5,0,0,5"
                        Command="{Binding SettingsPageCommand}"
                        Style="{DynamicResource MainButton}"
                        Content="Settings"/>
                    <Button 
                        Width="150"
                        Margin="5,0,0,5"
                        Command="{Binding SyncDriversCommand}"
                        Style="{DynamicResource MainButton}"
                        Content="Sync Drivers"/>
                </StackPanel>
                
                <!-- Front-End Version Display Badge -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,5" 
                        Background="{DynamicResource Color2}" CornerRadius="12" Padding="12,5">
                    <TextBlock x:Name="TxtAppVersion"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Color12}"
                               Text="v1.0.1"/>
                </Border>
            </Grid>
        </Grid>

    </Border>
</Window>
